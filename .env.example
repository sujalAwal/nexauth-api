# ============================================================================
# NexAuth API - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
#
# IMPORTANT: Never commit .env file to Git! It contains sensitive data.
#            Only commit .env.example as a template.
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application name
APP_NAME=NexAuth

# Environment type (development, staging, production)
APP_ENV=development

# Debug mode (True for development, False for production)
APP_DEBUG=True

# Application URL
APP_URL=http://localhost:8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database driver
DB_DRIVER=ODBC Driver 18 for SQL Server

# Database server (mssql for Docker, localhost for local, server.database.windows.net for Azure)
DB_SERVER=mssql

# Database port
DB_PORT=1433

# Database name
DB_NAME=nexauth_db

# Database username
DB_USER=sa

# Database password (CHANGE THIS IN PRODUCTION!)
DB_PASSWORD=YourPassword123!

# ============================================================================
# JWT (JSON Web Token) AUTHENTICATION
# ============================================================================

# Secret key for signing tokens (generate with: openssl rand -base64 32)
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT algorithm
ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Email server settings for Gmail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Email credentials (use App Password for Gmail, not your main password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Email sender information
MAIL_FROM=noreply@nexauth.com
MAIL_FROM_NAME=NexAuth Support

# Email encryption settings
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_TLS=True
MAIL_SSL=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Public API origins (allow all for development)
CORS_ORIGINS_PUBLIC=*

# Private API origins (your frontend domain)
CORS_ORIGINS_PRIVATE=http://localhost:3000